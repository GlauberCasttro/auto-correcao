{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/tools/guard-git.sh\"",
            "timeout": 20,
            "statusMessage": "guard-git (harness auto-correcao)"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/tools/guard-entrega.py\"",
            "timeout": 20,
            "statusMessage": "guard-entrega (harness auto-correcao)"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR}/.claude/tools/carimbo.sh\" --brief",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
